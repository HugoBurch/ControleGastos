{
  "expo": {
    "name": "Órbita Finanças",
    "slug": "orbita-financas",
    "scheme": "orbitafinancas",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbitafinancas.app",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.orbitafinancas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101112"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#031D27"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7a1c668c-41c8-45a8-a114-7ed6e14d1762"
      },
      "expo-navigation-bar": {
        "hidden": true
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/7a1c668c-41c8-45a8-a114-7ed6e14d1762"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
